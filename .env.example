# Copy this file to .env (same folder) and fill in whichever keys you're using — .env is
# gitignored, so real values never get committed. Every line here is optional; the tool works
# with none of them set, just with reduced automatic abbreviation resolution. See README.md ->
# "Setup" and "Automatic abbreviation lookup (UMLS and AI crosscheck)" for what each one does
# and where to get it.

# openFDA — raises the request-rate limit from 1,000/day to 120,000/day. Free, instant, no
# approval wait. Get one at https://open.fda.gov/apis/authentication/
OPENFDA_API_KEY=

# UMLS — automatic abbreviation lookup via NLM's curated medical terminology database. Free,
# but requires a real license request reviewed by hand (up to 3 business days). Get one at
# https://uts.nlm.nih.gov/uts/license
UMLS_API_KEY=

# Tavily + local Ollama — automatic abbreviation lookup fallback for whatever UMLS doesn't cover
# (searches the web, then has a local AI model extract the answer from the real results).
# TAVILY_API_KEY: free, instant, no card. Get one at https://tavily.com
# LOCAL_LLM_URL: where your local Ollama instance is running (its default port is 11434).
# LOCAL_LLM_MODEL: the model to use — a small, non-reasoning model (e.g. llama3.2:3b), not a
#   "thinking"/reasoning model (Qwen3, DeepSeek-R1, QwQ) — see README for why.
TAVILY_API_KEY=
LOCAL_LLM_URL=http://localhost:11434
LOCAL_LLM_MODEL=llama3.2:3b
